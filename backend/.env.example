PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kepk_db
DB_USER=postgres
DB_PASSWORD=
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
NODE_ENV=development

# Allowed CORS origin for the frontend (comma-separated for multiple origins, or * to allow all).
# Use a specific origin in production (e.g. https://kepk.example.com).
CORS_ORIGIN=http://localhost:3000

# Password reset email (required to send reset links)
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Transmedik tariff catalog (KEPK backend proxy)
TRANSMEDIK_INTEGRATION_API_KEY=
TRANSMEDIK_PAYMENT_CHECK_URL=http://localhost:5001/service/medifirst2000/bridging/kepk/cek-status-pembayaran
TRANSMEDIK_PRODUCT_LIST_URL=http://10.250.30.59/service/medifirst2000/bridging/kepk/get-data-produk
TRANSMEDIK_X_USERNAME=
TRANSMEDIK_X_TOKEN=
TRANSMEDIK_TIMEOUT_MS=10000
