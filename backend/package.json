{
  "name": "kepk",
  "version": "1.0.0",
  "description": "KEPK - Komite Etik Penelitian Kesehatan research permit management system",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/config/migrate.js",
    "db:setup": "node src/config/setup-db.js",
    "test": "jest --runInBand --forceExit",
    "test:auth": "jest --runInBand --forceExit --testPathPatterns=auth",
    "migrate:roles": "node src/config/migrate-role-names.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/src/__tests__/**/*.test.js"
    ],
    "testTimeout": 30000
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "puppeteer": "^24.43.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "nodemailer": "^7.0.10"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
