          }]
        },
        {
          "name": "Download Letter",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/letters/{{permit_id}}/download",
            "header": [{ "key": "Authorization", "value": "Bearer {{researcher_token}}" }]
          }
        }
      ]
